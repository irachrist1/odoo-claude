# Copy to .env and fill in. NEVER commit the real .env (it holds a password-equivalent key).

# Your Odoo instance
ODOO_URL=https://rw-andersen.odoo.com

# On Odoo Online the database name is the subdomain
ODOO_DB=rw-andersen

# Your Odoo login email
ODOO_USERNAME=you@maj-andersen.com

# Generate in Odoo: avatar -> Preferences -> Account Security -> New API Key
ODOO_API_KEY=paste_your_api_key_here

# Safety: writes (create/update) are OFF by default. Set to "true" to allow Claude
# to modify Odoo data. Start read-only, turn this on once you trust the workflows.
ODOO_ENABLE_WRITES=false

# Transport: "stdio" for Claude Desktop / Claude Code (default), "http" to self-host
# as a Custom Connector for the team.
MCP_TRANSPORT=stdio
